# Copy this file to .env.local and fill in your values
# Never commit .env.local to git

# Your Neon PostgreSQL connection string
# Get this from https://console.neon.tech → your project → Connection string

# Pooled connection — used by Prisma at runtime
DATABASE_URL="postgresql://user:password@****-pooler.****.neon.tech/nexus?sslmode=require"

# Direct connection — used by Prisma migrate only
DIRECT_URL="postgresql://user:password@****.****.neon.tech/nexus?sslmode=require"


# Your login passphrase — make it long and memorable
# This is the password you'll type on the login screen
APP_PASSWORD="your-long-secret-passphrase-here"

# A random secret for signing JWT tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-random-jwt-secret-here"
