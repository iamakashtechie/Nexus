# Copy this file to .env.local and fill in your values
# Never commit .env.local to git

# Your Neon PostgreSQL connection string
# Get this from https://console.neon.tech → your project → Connection string

# Pooled connection — used by Prisma at runtime
DATABASE_URL="postgresql://user:password@****-pooler.****.neon.tech/nexus?sslmode=require"

# Direct connection — used by Prisma migrate only
DIRECT_URL="postgresql://user:password@****.****.neon.tech/nexus?sslmode=require"


# Your login passphrase hash (bcrypt) — never store plaintext passwords
# Generate with: node -e "const bcrypt=require('bcryptjs'); const h=bcrypt.hashSync('your-long-secret-passphrase-here',12); console.log(h.replace(/\$/g,'\\$'))"
# `$` is escaped for .env compatibility (Next.js expands `$VARS`)
# Note: In Vercel dashboard, do NOT escape the $ (use $2b$12$... directly)
APP_PASSWORD_HASH="\$2b\$12\$replace-with-your-generated-bcrypt-hash"

# A random secret for signing JWT tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-random-jwt-secret-here"

# Allow local network dev access without committing IP to git (Optional)
# DEV_IP_ADDRESS="192.168.1.100"
