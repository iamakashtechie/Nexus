{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:generate": "dotenv -e .env.local -- prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/extension-code-block-lowlight": "^3.20.4",
    "@tiptap/react": "^3.20.4",
    "@tiptap/starter-kit": "^3.20.4",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^13.0.0",
    "geist": "^1.7.0",
    "jose": "^6.2.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.30.0",
    "mermaid": "^11.13.0",
    "next": "^16.2.3",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.0",
    "prisma": "^6.19.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.2": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.11.1": true
  }
}
